# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example
config/local.yaml

# Lock files
*-lock.yaml
*-lock.json
# CI 构建需要可复现依赖树，lockfile 必须入库
!pnpm-lock.yaml

# PNPM store
.pnpm-store

# Temporary agent files
# Throwaway scripts and snapshots written while verifying a change (they are
# meant to be deleted again, but must never be committed by accident).
.tmp-*
migrations/*
