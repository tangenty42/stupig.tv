# Database
DB_HOST=<your-mysql-host>
DB_PORT=3306
DB_USER=<your-mysql-user>
DB_PASSWORD=<your-mysql-password>
DB_NAME=stupig_tv

# JWT
JWT_SECRET=<random-string-at-least-32-chars>
JWT_EXPIRES_IN_DAYS=14
JWT_RENEW_BEFORE_DAYS=7
BCRYPT_ROUNDS=12

# Aliyun
ALIYUN_ACCESS_KEY_ID=<your-aliyun-access-key-id>
ALIYUN_ACCESS_KEY_SECRET=<your-aliyun-access-key-secret>
ALIYUN_DYPNSAPI_ENDPOINT=dypnsapi.aliyuncs.com
ALIYUN_DYPNSAPI_REGION_ID=cn-hangzhou

# Aliyun SMS
OTP_EXPIRES_MINUTES=10
OTP_TIER1_DAILY_LIMIT=5
OTP_TIER1_COOLDOWN_MS=60000
OTP_TIER2_DAILY_LIMIT=5
OTP_TIER2_COOLDOWN_MS=1800000
OTP_SMS_SIGN_NAME=<your-aliyun-sms-sign-name>
OTP_SMS_TEMPLATE_CODE=<your-aliyun-sms-template-code>
OTP_SMS_SCHEME_NAME=<your-aliyun-sms-scheme-name>
OTP_DEBUG=false

# Aliyun Captcha
CAPTCHA_APP_ID=<aliyun-captcha-app-id>
CAPTCHA_APP_KEY=<aliyun-captcha-app-key>

# App
STATIC_BASE_URL=https://static-stupig-tv.cn-nb1.rains3.com
SITE_URL=https://www.stupig.tv
SITE_INDEXABLE=true
API_BASE=/api
COOKIE_MAX_AGE_DAYS=14
SESSION_MAX_AGE_DAYS=14
SESSION_MAX_TOKEN_GENERATIONS=8
COLOR_MODE_FALLBACK=dark
IDENTITY_COOKIE_NAME=stupig_identity
IDENTITY_COOKIE_MAX_AGE_DAYS=30
COLOR_MODE_COOKIE_NAME=stupig_color_mode
TIMEZONE_COOKIE_NAME=stupig_timezone
AUTH_TOKEN_COOKIE_NAME=stupig_session
AUTH_USER_COOKIE_NAME=login
SYNC_BROADCAST_CHANNEL_NAME=stupig_sync_events
SYNC_CLIENT_ID_STORAGE_KEY=stupig_sync_client_id
MAX_AVATAR_SIZE_MB=5
MAX_CONTENT_ATTACHMENT_SIZE_MB=20
CONTENT_STORY_TITLE_MAX_LENGTH=60
CONTENT_LINK_FILE_NAME_MAX_BYTES=255
CONTENT_STORY_LABEL_MAX_BYTES=255
CONTENT_STORY_DESC_MAX_BYTES=500
CONTENT_STORY_COVER_MAX_BYTES=255
CONTENT_STORY_MARKDOWN_MAX_BYTES=1048576
CONTENT_DRAFT_SCHEMA_VERSION=2
CONTENT_DRAFT_STORAGE_PREFIX=stupig_content_draft_
CONTENT_DRAFT_AUTOSAVE_DELAY_MS=1000
CONTENT_UPLOAD_HANDLE_STORAGE_NAME=stupig_content_upload_handles
CONTENT_OPERATION_LOCK_TTL_SECONDS=120
ONLINE_TIMEOUT_SECONDS=16
PING_IDLE_INTERVAL_SECONDS=4
POLL_INTERVAL_SECONDS=4

# OSS
OSS_ENDPOINT=<your-oss-endpoint>
OSS_REGION=<your-oss-region>
OSS_BUCKET=<your-oss-bucket>
OSS_ACCESS_KEY_ID=<your-oss-access-key-id>
OSS_ACCESS_KEY_SECRET=<your-oss-access-key-secret>
OSS_FORCE_PATH_STYLE=<true-or-false>

# Bilibili video cards (link metadata prefetch)
BILIBILI_FETCH_TIMEOUT_MS=5000
BILIBILI_CACHE_TTL_MS=86400000
BILIBILI_NEGATIVE_CACHE_TTL_MS=300000
BILIBILI_FETCH_FAILURE_COOLDOWN_MS=300000

# Redis (video card metadata cache)
REDIS_HOST=<your-redis-host>
REDIS_PORT=6379
REDIS_PASSWORD=

# MQTT (EMQX)
MQTT_HOST=<your-mqtt-host>
MQTT_PORT=1883
MQTT_WS_HOST=<your-mqtt-ws-host>
MQTT_WS_PORT=8083
MQTT_WSS_PORT=8084
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_QOS=1
MQTT_TOPIC_PREFIX=stupig/sync
MQTT_CLIENT_ID_PREFIX_SERVER=server
MQTT_CLIENT_ID_PREFIX_WEB=web
