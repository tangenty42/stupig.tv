# 本文件只放敏感信息（密钥、密码）。层次化配置在 config/*.yaml，
# YAML 里用 ${VAR} 引用这里定义的变量；可选变量对应 ${VAR:-} 写法。

# Database
DB_PASSWORD=<your-mysql-password>

# Auth
JWT_SECRET=<random-string-at-least-32-chars>

# Aliyun
ALIYUN_ACCESS_KEY_ID=<your-aliyun-access-key-id>
ALIYUN_ACCESS_KEY_SECRET=<your-aliyun-access-key-secret>

# Aliyun Captcha（appId 非敏感，在 config/default.yaml 的 aliyun.captcha.appId）
ALIYUN_CAPTCHA_APP_KEY=<aliyun-captcha-app-key>

# OSS
OSS_ACCESS_KEY_ID=<your-oss-access-key-id>
OSS_ACCESS_KEY_SECRET=<your-oss-access-key-secret>

# Redis（无密码可留空或删除此行）
REDIS_PASSWORD=<your-redis-password>

# MQTT（无需认证可留空或删除这两行）
MQTT_USERNAME=
MQTT_PASSWORD=

# 仅服务器部署目录的 .env 需要：docker-compose.yml 镜像名插值用
# （与应用无关，应用代码不读这个变量）
# ACR_IMAGE=<acr-registry-host>/<namespace>/<image-name>
