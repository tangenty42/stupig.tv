# 本文件放密钥与环境差异（主机名/端口/URL）。层次化配置在 config/*.yaml，
# YAML 里用 ${VAR} 引用这里定义的变量；可选变量对应 ${VAR:-} 写法。
# 本机 .env 不进仓库；服务器部署目录的 .env 按需填生产值。

# ══ 机密（密钥/密码，各环境各自填写）═══════════════════

# ── 应用 ──────────────────────────────────────────────
JWT_SECRET=<random-string-at-least-32-chars>

# ── MySQL ─────────────────────────────────────────────
# 应用账号 stupig_tv 的密码（config/*.yaml 的 db.password 引用；
# docker-compose.dev.yml 建容器时注入同一变量，改密码只改这里）
MYSQL_PASSWORD=<your-mysql-password>
# 仅本地开发：docker-compose.dev.yml 建容器时的 root 管理员密码，
# phpMyAdmin 免密登录也用它
MYSQL_DEV_ROOT_PASSWORD=root

# ── Redis ─────────────────────────────────────────────
# 无密码可留空或删除此行
REDIS_PASSWORD=<your-redis-password>

# ── MQTT / EMQX ───────────────────────────────────────
# 无需认证可留空或删除这两行
MQTT_USERNAME=
MQTT_PASSWORD=

# ── Aliyun ────────────────────────────────────────────
ALIYUN_ACCESS_KEY_ID=<your-aliyun-access-key-id>
ALIYUN_ACCESS_KEY_SECRET=<your-aliyun-access-key-secret>
# appId 非敏感，在 config/default.yaml 的 aliyun.captcha.appId
ALIYUN_CAPTCHA_APP_KEY=<aliyun-captcha-app-key>

# ── OSS ───────────────────────────────────────────────
# 生产与开发用不同的桶（default.yaml: static-stupig-tv，
# development.yaml 覆盖为 static-stupig-tv-dev），AccessKey 通常也按桶
# 分开授权，因此各环境填各自的密钥
OSS_ACCESS_KEY_ID=<your-oss-access-key-id>
OSS_ACCESS_KEY_SECRET=<your-oss-access-key-secret>

# ══ 环境差异（主机名/端口/URL，下值为本地开发默认）═══════

# ── 应用 ──────────────────────────────────────────────
# dev server、docker-compose.yml 的端口映射与 healthcheck、
# development.yaml 的 site.url 共用这一个端口
APP_PORT=3042

# ── MySQL ─────────────────────────────────────────────
# 开发：127.0.0.1 + docker-compose.dev.yml 映射的端口；
# 生产：容器网络内的主机名
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# ── Redis ─────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── MQTT / EMQX ───────────────────────────────────────
MQTT_HOST=127.0.0.1
MQTT_TCP_PORT=1883
# 浏览器 WebSocket 连接（default.yaml mqtt.web.wsUrl 引用，会下发到客户端）：
# 开发直连本机 EMQX；生产填反代+SSL 后的完整地址（无需端口）。
# 生产镜像构建时拿不到 .env，客户端实际拿到的值由 docker-compose.yml 在容器
# 启动时经 NUXT_PUBLIC_MQTT_WEB_URL 注入，改这里重启容器即可，无需重建镜像；
# 漏注入或与这里的值对不上，服务端启动断言会让容器直接起不来（不会静默下发空串）。
MQTT_WEB_URL=ws://localhost:8083/mqtt
# 仅本地开发（docker-compose.dev.yml）：EMQX WebSocket 映射到宿主机的端口，
# 必须与上一行 MQTT_WEB_URL 里的端口一致
MQTT_WS_PORT=8083

# ── 仅本地开发（docker-compose.dev.yml）────────────────
EMQX_DEV_DASHBOARD_PORT=18083
PHPMYADMIN_DEV_PORT=8081

# ── 仅服务器部署（docker-compose.yml）──────────────────
# 应用容器接入的外部 Docker 网络名（由 1panel 等外部创建）
# EXTERNAL_DOCKER_NETWORK=<your-docker-network>
# ACR_IMAGE=<your-registry-image>
