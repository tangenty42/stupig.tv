# 本文件放密钥、主机名与端口等环境差异。层次化配置在 config/*.yaml，
# YAML 里用 ${VAR} 引用这里定义的变量；可选变量对应 ${VAR:-} 写法。
# 本机 .env 不进仓库；服务器部署目录的 .env 按需填生产值。

# ── 应用 ──────────────────────────────────────────────
# dev server、docker-compose.yml 的端口映射与 healthcheck、
# development.yaml 的 site.url 共用这一个端口
APP_PORT=3042
JWT_SECRET=<random-string-at-least-32-chars>

# ── MySQL ─────────────────────────────────────────────
# 开发：127.0.0.1 + docker-compose.dev.yml 映射的端口；
# 生产：容器网络内的主机名
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# 应用连接密码（config/*.yaml 的 db.password 引用）
DB_PASSWORD=<your-mysql-password>
# 仅本地开发：docker-compose.dev.yml 创建容器时注入，MYSQL_PASSWORD 会被
# development.yaml 的 db.password 引用，改密码只改这里，两边自动一致
MYSQL_ROOT_PASSWORD=root
MYSQL_PASSWORD=<dev-mysql-password>

# ── Redis ─────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 无密码可留空或删除此行
REDIS_PASSWORD=<your-redis-password>

# ── MQTT / EMQX ───────────────────────────────────────
MQTT_HOST=127.0.0.1
MQTT_TCP_PORT=1883
# 无需认证可留空或删除这两行
MQTT_USERNAME=
MQTT_PASSWORD=
# 浏览器 WebSocket 连接（default.yaml mqtt.web 引用，会下发到客户端）：
# 开发用 localhost；生产填浏览器可达的域名
MQTT_WS_HOST=localhost
MQTT_WS_PORT=8083

# ── 仅本地开发（docker-compose.dev.yml）────────────────
EMQX_DASHBOARD_PORT=18083
PHPMYADMIN_PORT=8081

# ── 仅服务器部署（docker-compose.yml）──────────────────
# 应用容器接入的外部 Docker 网络名（由 1panel 等外部创建）
# EXTERNAL_DOCKER_NETWORK=<your-docker-network>
# ACR_IMAGE=<your-registry-image>

# ── Aliyun ────────────────────────────────────────────
ALIYUN_ACCESS_KEY_ID=<your-aliyun-access-key-id>
ALIYUN_ACCESS_KEY_SECRET=<your-aliyun-access-key-secret>
# appId 非敏感，在 config/default.yaml 的 aliyun.captcha.appId
ALIYUN_CAPTCHA_APP_KEY=<aliyun-captcha-app-key>

# ── OSS ───────────────────────────────────────────────
OSS_ACCESS_KEY_ID=<your-oss-access-key-id>
OSS_ACCESS_KEY_SECRET=<your-oss-access-key-secret>
