# 开发环境

# 本机 HTTPS 入口 https://localhost:3042，两个浏览器 WSS 地址也使用此端口
APP_PORT=3042

# 开发隧道认证，须与服务端 frps 的 auth.token 一致
DEV_FRP_TOKEN=<required>

# ESA 函数鉴权密钥：32–128 个可见 ASCII 字符，不含空格
ALIYUN_ESA_AUTH_KEY=<required>

# ESA 缓存刷新与预热凭据
ALIYUN_ESA_ACCESS_KEY_ID=<required>
ALIYUN_ESA_ACCESS_KEY_SECRET=<required>
# 附件分发域名所属 ESA 站点的 SiteId
ALIYUN_ESA_SITE_ID=<required>

# ESA 函数发布凭据，使用独立于缓存维护的 RAM 用户
ALIYUN_ESA_PUBLISH_ACCESS_KEY_ID=<required>
ALIYUN_ESA_PUBLISH_ACCESS_KEY_SECRET=<required>

# 短信和图形验证调试开关
NUXT_OTP_DEBUG=true
NUXT_CAPTCHA_DEBUG=true

# 本机加解密 .env.prod.gpg 的口令，须与 GitHub Secret 一致
ENV_PASSPHRASE=<required>

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=stupig_tv
MYSQL_DATABASE=stupig_tv
# 本地 Compose 建库与 phpMyAdmin 使用的 root 密码
MYSQL_DEV_ROOT_PASSWORD=root

# Redis；本地容器无密码
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# MQTT：服务端发布凭据与 TCP 连接
MQTT_USERNAME=emqx-dev
MQTT_PASSWORD=emqx-dev
MQTT_HOST=127.0.0.1
MQTT_TCP_PORT=1883
# 公开通知的 EMQX 回环端口，由应用的 /mqtt 入口转发
MQTT_WS_PORT=8083
# 私有草稿通知的 EMQX 回环端口，由应用的 /mqtt-drafts 入口转发
MQTT_DRAFT_WS_PORT=8086

# 本地管理页面端口
EMQX_DEV_DASHBOARD_PORT=18083
PHPMYADMIN_DEV_PORT=8081
