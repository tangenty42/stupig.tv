# 本地开发的环境差异值（主机名/端口/URL），下值开箱即用。
# dev server 与独立脚本统一加载 .env.dev。
# 与 .env.shared.layer 合并生成开发环境的 .env.dev。

# ── 应用 ──────────────────────────────────────────────
# dev server 端口；config/dev.yaml 用此值拼出本地站点 URL
APP_PORT=3042

# 开发授权回调的 frp 客户端认证。必须与服务器 frps 的 auth.token 一致。
# pnpm env:build --dev 会提示填写并写入本地 .env.dev；真实 token 不写入模板。
# 地址、端口与回调入口配置见 config/dev.yaml 的 devAuthTunnel。
# 仅用于开发隧道，不复用 ESA 发布凭据，也不进入生产环境模板。
DEV_FRP_TOKEN=<required>

# ESA 开发函数的独立鉴权密钥（32～128 位可见 ASCII 字符，不含空格）；与云端加密变量 ALIYUN_ESA_AUTH_KEY 一致。
# env:build 提示填写；需先发布 config/esa/content-auth.mjs 对应的边缘函数。
ALIYUN_ESA_AUTH_KEY=<required>

# ESA 管理 API（附件退役后的缓存刷新，仅服务端），独立于上面的链接鉴权密钥。
# RAM 用户：stupig-esa-purge-dev；策略：stupig-esa-purge-dev-access。
# 最小权限：指定站点的 esa:PurgeCaches、esa:DescribePurgeTasks。
# 实际凭证通过 pnpm env:build:dev 填入本地 .env，模板只保留占位符。
ALIYUN_ESA_ACCESS_KEY_ID=<required>
ALIYUN_ESA_ACCESS_KEY_SECRET=<required>
# 现有文档记录 tangenty.cn 的 SiteId 为 181553031729356，填写前请在控制台核对。
ALIYUN_ESA_SITE_ID=<required>

# ESA 独立发布凭据，仅 pnpm esa:deploy:dev 使用，不下发应用浏览器。
# RAM 用户：stupig-esa-publish-dev；策略：stupig-esa-publish-dev-access。
# 策略 JSON：config/ram/stupig-esa-publish-dev-access.json；发布流程见 docs/deployment/esa-functions.md。
# 与缓存刷新 RAM 用户分开；通过 pnpm env:build:dev 填入本地 .env，不将真实凭据写入模板。
# 函数名、回调与发布槽位统一在 config/dev.yaml 的 esaFunction 栏目；发布工具负责映射 CLI 凭据。
ALIYUN_ESA_PUBLISH_ACCESS_KEY_ID=<required>
ALIYUN_ESA_PUBLISH_ACCESS_KEY_SECRET=<required>

# OSS 通用默认值在 config/shared.yaml，开发地址、地域和桶名在 config/dev.yaml。
# 静态资源与 Content 共用 ALIYUN_OSS_*。

# 仅本地开发；生产必须为 false，服务端启动会校验
NUXT_OTP_DEBUG=true
NUXT_CAPTCHA_DEBUG=true

# 本机加密、解密和校验 .env.prod.gpg 用；只保存在 gitignore 的本地 .env，不进服务端配置
ENV_PASSPHRASE=<required>

# ── MySQL ─────────────────────────────────────────────
# docker-compose.dev.yml 映射的宿主机地址与端口
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# 默认值也用于本地 Compose 创建数据库
MYSQL_USER=stupig_tv
MYSQL_DATABASE=stupig_tv
# docker-compose.dev.yml 建容器时的 root 管理员密码，phpMyAdmin 免密登录也用它
MYSQL_DEV_ROOT_PASSWORD=root

# ── Redis ─────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 本地容器无密码，留空
REDIS_PASSWORD=

# ── MQTT / EMQX ───────────────────────────────────────
# 服务端连接本地 EMQX 的固定开发凭据；浏览器端不需要这两个变量，
# 浏览器在匿名 WS listener 上仅由 ACL 允许订阅；clientId 前缀不授予权限
MQTT_USERNAME=emqx-dev
MQTT_PASSWORD=emqx-dev
MQTT_HOST=127.0.0.1
MQTT_TCP_PORT=1883
# 浏览器 WebSocket 连接（YAML 显式引用后下发到客户端）：直连本机 EMQX
MQTT_WEB_URL=ws://localhost:8083/mqtt
# docker-compose.dev.yml 把 EMQX WebSocket 映射到宿主机的端口，
# 必须与上一行 MQTT_WEB_URL 里的端口一致
MQTT_WS_PORT=8083
MQTT_DRAFT_WS_PORT=8086
MQTT_DRAFT_WEB_URL=ws://localhost:8086/mqtt
EMQX_DEV_DASHBOARD_PORT=18083
PHPMYADMIN_DEV_PORT=8081
# 阿里云 DYPNS 与目标 OSS 的独立凭证占位见 .env.shared.layer。
# ALIYUN_OSS_* 用于当前静态资源、头像与 Content。
