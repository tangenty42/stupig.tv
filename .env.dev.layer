# 本地开发的环境差异值（主机名/端口/URL），下值开箱即用。
# dev server 由 Nuxt CLI 加载 .env；独立脚本显式加载。
# 与 .env.shared.layer 合并生成开发环境的 .env。

# ── 应用 ──────────────────────────────────────────────
# dev server 端口；config/development.yaml 用此值拼出本地站点 URL
APP_PORT=3042

# 仅本地开发；生产必须为 false，服务端启动会校验
NUXT_OTP_DEBUG=true

# 本机加密、解密和校验 .env.prod.gpg 用；只保存在 gitignore 的本地 .env，不进服务端配置
ENV_PASSPHRASE=<required>

# ── MySQL ─────────────────────────────────────────────
# docker-compose.dev.yml 映射的宿主机地址与端口
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# 默认值也用于本地 Compose 创建数据库
MYSQL_USER=stupig_tv
MYSQL_DATABASE=stupig_tv
# docker-compose.dev.yml 建容器时的 root 管理员密码，phpMyAdmin 免密登录也用它
MYSQL_DEV_ROOT_PASSWORD=root

# ── Redis ─────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 本地容器无密码，留空
REDIS_PASSWORD=

# ── MQTT / EMQX ───────────────────────────────────────
# 服务端连接本地 EMQX 的固定开发凭据；浏览器端不需要这两个变量，
# 靠 clientId 前缀 web_ 走 ACL 只读订阅
MQTT_USERNAME=emqx-dev
MQTT_PASSWORD=emqx-dev
MQTT_HOST=127.0.0.1
MQTT_TCP_PORT=1883
# 浏览器 WebSocket 连接（YAML 显式引用后下发到客户端）：直连本机 EMQX
MQTT_WEB_URL=ws://localhost:8083/mqtt
# docker-compose.dev.yml 把 EMQX WebSocket 映射到宿主机的端口，
# 必须与上一行 MQTT_WEB_URL 里的端口一致
MQTT_WS_PORT=8083
EMQX_DEV_DASHBOARD_PORT=18083
PHPMYADMIN_DEV_PORT=8081
