{
  "name": "stupig-tv",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "storage:cleanup": "tsx --tsconfig scripts/tsconfig.json scripts/cleanup-orphan-attachments.ts",
    "db:dump:dev": "tsx --tsconfig scripts/tsconfig.json scripts/dump-desensitized.ts",
    "dev": "nuxt dev --host 0.0.0.0",
    "dev:services": "docker compose -f docker-compose.dev.yml up -d",
    "dev:all": "pnpm dev:services && pnpm dev",
    "env:build": "tsx --tsconfig scripts/tsconfig.json scripts/sync-env.ts",
    "env:build:dev": "tsx --tsconfig scripts/tsconfig.json scripts/sync-env.ts --dev",
    "env:build:prod": "tsx --tsconfig scripts/tsconfig.json scripts/sync-env.ts --prod",
    "env:encrypt": "tsx --tsconfig scripts/tsconfig.json scripts/gpg-env.ts encrypt",
    "env:decrypt": "tsx --tsconfig scripts/tsconfig.json scripts/gpg-env.ts decrypt",
    "generate": "nuxt generate",
    "settings:generate": "tsx config/lib/generate.ts",
    "settings:check": "tsx config/lib/generate.ts --check",
    "maintenance:build": "pnpm settings:generate && esbuild scripts/cleanup-orphan-attachments.ts --bundle --platform=node --format=esm --target=node24 --alias:@config=./config/lib --alias:@shared=./server/shared --alias:@server=./server --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\" --outfile=.output/server/maintenance/cleanup.mjs && esbuild scripts/migrate.ts --bundle --platform=node --format=esm --target=node24 --alias:@config=./config/lib --alias:@shared=./server/shared --alias:@server=./server --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\" --outfile=.output/server/maintenance/migrate.mjs",
    "migrate": "tsx --tsconfig scripts/tsconfig.json scripts/migrate.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "simple-git-hooks",
    "test": "vitest run"
  },
  "dependencies": {
    "@alicloud/dypnsapi20170525": "^2.0.0",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/tea-util": "^1.4.11",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "1.2.3",
    "@pinia/nuxt": "^1.0.1",
    "@primeuix/themes": "2.0.3",
    "@primevue/forms": "4.5.5",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@vueuse/nuxt": "^14.3.0",
    "bcryptjs": "^3.0.3",
    "codemirror": "^6.0.2",
    "cropperjs": "^1.6.2",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "markdown-it": "^14.3.0",
    "markdown-it-multimd-table": "^4.2.3",
    "markdownlint": "^0.41.1",
    "mqtt": "^5.15.2",
    "mysql2": "^3.23.1",
    "node-sql-parser": "^5.4.0",
    "pinia": "^4.0.2",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "tailwindcss-primeui": "^0.6.1",
    "ua-parser-js": "^2.0.10",
    "viewerjs": "^1.11.8",
    "vite-tsconfig-paths": "^6.1.1",
    "vue": "^3.5.40",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@iconify-json/lucide": "^1.2.118",
    "@nuxt/icon": "^2.3.1",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/robots": "^6.2.0",
    "@nuxtjs/sitemap": "^8.5.0",
    "@primevue/nuxt-module": "^4.5.5",
    "@teages/nuxt-legacy": "^3.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-legacy": "^8.2.1",
    "autoprefixer": "^10.5.4",
    "browserslist": "^4.28.6",
    "esbuild": "0.28.1",
    "eslint": "^10.7.0",
    "lint-staged": "^17.2.0",
    "nuxt": "^4.6.1",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,ts,vue,json,jsonc,json5,yaml,yml,md}": "eslint --fix --no-warn-ignored"
  },
  "browserslist": {
    "production": [
      "Chrome >= 80",
      "Edge >= 80",
      "Firefox >= 78",
      "Safari >= 13.1"
    ],
    "development": [
      "last 1 chrome version"
    ]
  }
}
