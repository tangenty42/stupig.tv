# 公共密钥：两个环境都要按各自的账号各填一份。结构化配置在 config/*.yaml，
# 稳定且浏览器共享的业务参数在 config/app-settings.yaml。
# 本文件与某个环境层（.env.dev.layer / .env.prod.layer）
# 由 pnpm env:build 合并后重建 .env.dev 或 .env.prod。

# ══ 机密（密钥/密码，各环境各自填写）═══════════════════

# ── 应用 ──────────────────────────────────────────────
JWT_SECRET=<required>

# ── MySQL ─────────────────────────────────────────────
MYSQL_PASSWORD=<required>

# ── Aliyun ────────────────────────────────────────────
ALIYUN_DYPNS_ACCESS_KEY_ID=<required>
ALIYUN_DYPNS_ACCESS_KEY_SECRET=<required>
ALIYUN_DYPNS_CAPTCHA_APP_KEY=<required>

# 阿里云 OSS 使用独立 RAM 用户；启用 aliyun.oss 后读取，不能复用 DYPNS 凭证。
ALIYUN_OSS_ACCESS_KEY_ID=<required>
ALIYUN_OSS_ACCESS_KEY_SECRET=<required>

# 静态资源与 Content 共用本环境的 ALIYUN_OSS_* 身份和桶。
# 历史源凭据仅存放在受保护的迁移备份中，不进入日常应用环境。
