# 公共密钥：两个环境都要按各自的账号各填一份。结构化配置在 config/*.yaml，
# 稳定且浏览器共享的业务参数在 config/app-settings.yaml。
# 本文件与某个环境层（.env.dev.layer / .env.prod.layer）
# 由 pnpm env:build 合并后重建 .env。

# ══ 机密（密钥/密码，各环境各自填写）═══════════════════

# ── 应用 ──────────────────────────────────────────────
JWT_SECRET=<required>

# ── MySQL ─────────────────────────────────────────────
MYSQL_PASSWORD=<required>

# ── MQTT / EMQX ───────────────────────────────────────
# 服务端连接 EMQX 的凭据。开发环境用 emqx-dev/emqx-dev，生产填强密码。
# 浏览器端不需要这两个变量——靠 clientId 前缀 web_ 走 ACL 只读订阅。
MQTT_USERNAME=emqx-dev
MQTT_PASSWORD=emqx-dev

# ── Aliyun ────────────────────────────────────────────
ALIYUN_ACCESS_KEY_ID=<required>
ALIYUN_ACCESS_KEY_SECRET=<required>
ALIYUN_CAPTCHA_APP_KEY=<required>

# ── OSS ───────────────────────────────────────────────
# 生产与开发用不同的 OSS 桶，AccessKey 通常也按桶分开授权
OSS_ACCESS_KEY_ID=<required>
OSS_ACCESS_KEY_SECRET=<required>
