{
  // 让编辑器/tsx 识别 scripts/**/*.ts 里的 @server、@shared 别名。
  // 不继承 .nuxt 的 tsconfig——那些是 Nuxt 生成物，scripts 是独立 Node 脚本。
  // 不被根 tsconfig 的 references 引用，独立检查 CLI 和迁移的 Node 环境。
  // Docker 先编译维护产物，最终运行镜像不包含 scripts 源码。编辑器按"就近
  // tsconfig"规则处理 scripts/ 下的文件。
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@config/*": ["../config/lib/*"],
      "@server": ["../server"],
      "@server/*": ["../server/*"],
      "@shared/*": ["../server/shared/*"]
    },
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true
  },
  // 收维护工具与版本化 TS 迁移；被 import 的 server 模块由 paths 解析并作为依赖
  // 参与本次检查，但不要用 include 把整个 server/ 拖进来——它缺少 Nuxt/h3 的
  // 自动导入类型，会报一堆假错误。
  "include": ["./**/*.ts", "../migrations/**/*.ts"]
}
