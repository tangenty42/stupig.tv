{
  "Version": "1",
  "Statement": [
    {
      "Sid": "AuditBucketInventory",
      "Effect": "Allow",
      "Action": "oss:ListObjects",
      "Resource": "acs:oss:*:1225000469589595:stupig-static-dev"
    },
    {
      "Sid": "StaticAssets",
      "Effect": "Allow",
      "Action": [
        "oss:GetObject",
        "oss:PutObject",
        "oss:GetObjectAcl",
        "oss:PutObjectAcl",
        "oss:DeleteObject"
      ],
      "Resource": [
        "acs:oss:*:1225000469589595:stupig-static-dev/imgs/*",
        "acs:oss:*:1225000469589595:stupig-static-dev/avatar/*"
      ]
    },
    {
      "Sid": "ContentObjectOperations",
      "Effect": "Allow",
      "Action": [
        "oss:GetObject",
        "oss:PutObject",
        "oss:GetObjectAcl",
        "oss:PutObjectAcl",
        "oss:DeleteObject",
        "oss:ListParts",
        "oss:AbortMultipartUpload"
      ],
      "Resource": "acs:oss:*:1225000469589595:stupig-static-dev/content/att/*"
    },
    {
      "Sid": "RecoverIncompleteUploads",
      "Effect": "Allow",
      "Action": "oss:ListMultipartUploads",
      "Resource": "acs:oss:*:1225000469589595:stupig-static-dev"
    },
    {
      "Sid": "VerifyRecoverableDeletion",
      "Effect": "Allow",
      "Action": "oss:GetBucketVersioning",
      "Resource": "acs:oss:*:1225000469589595:stupig-static-dev"
    },
    {
      "Sid": "ForceTLS",
      "Effect": "Deny",
      "Action": "oss:*",
      "Resource": [
        "acs:oss:*:1225000469589595:stupig-static-dev",
        "acs:oss:*:1225000469589595:stupig-static-dev/*"
      ],
      "Condition": {
        "Bool": {
          "acs:SecureTransport": "false"
        }
      }
    },
    {
      "Sid": "RejectPublicContentACL",
      "Effect": "Deny",
      "Action": [
        "oss:PutObject",
        "oss:PutObjectAcl"
      ],
      "Resource": "acs:oss:*:1225000469589595:stupig-static-dev/content/att/*",
      "Condition": {
        "StringEquals": {
          "oss:x-oss-object-acl": [
            "public-read",
            "public-read-write"
          ]
        }
      }
    },
    {
      "Sid": "PreserveContentVersions",
      "Effect": "Deny",
      "Action": "oss:DeleteObjectVersion",
      "Resource": "acs:oss:*:1225000469589595:stupig-static-dev/content/att/*"
    }
  ]
}
