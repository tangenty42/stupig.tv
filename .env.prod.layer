# 生产环境

# 应用端口
APP_PORT=3042

# ESA 函数鉴权密钥：32–128 个可见 ASCII 字符，不含空格；与开发分开
ALIYUN_ESA_AUTH_KEY=<required>

# ESA 缓存刷新与预热凭据
ALIYUN_ESA_ACCESS_KEY_ID=<required>
ALIYUN_ESA_ACCESS_KEY_SECRET=<required>
# 附件分发域名所属 ESA 站点的 SiteId
ALIYUN_ESA_SITE_ID=<required>

# ESA 函数发布凭据，使用独立于开发及缓存维护的 RAM 用户
ALIYUN_ESA_PUBLISH_ACCESS_KEY_ID=<required>
ALIYUN_ESA_PUBLISH_ACCESS_KEY_SECRET=<required>

# 生产必须关闭调试
NUXT_OTP_DEBUG=false
NUXT_CAPTCHA_DEBUG=false

# MySQL：应用容器可达的地址
MYSQL_HOST=<required>
MYSQL_PORT=3306
MYSQL_USER=<required>
MYSQL_DATABASE=<required>

# Redis：应用容器可达的地址，须设置密码
REDIS_HOST=<required>
REDIS_PORT=6379
REDIS_PASSWORD=<required>

# MQTT：服务端发布凭据与 TCP 连接，密码使用强密码
MQTT_USERNAME=<required>
MQTT_PASSWORD=<required>
MQTT_HOST=emqx
MQTT_TCP_PORT=1883
# 公开通知：端口仅供宿主机反代，浏览器地址填完整公网 WSS URL
MQTT_WS_PORT=8085
MQTT_WEB_URL=<required>
# 私有草稿通知：反代端口与完整公网 WSS URL
MQTT_DRAFT_WS_PORT=8086
MQTT_DRAFT_WEB_URL=wss://mqtt.stupig.tv/mqtt-drafts

# 应用接入的外部 Docker 网络，须已创建
EXTERNAL_DOCKER_NETWORK=<required>
# ACR 镜像地址：Registry 域名/命名空间/仓库名，不带 tag
ACR_IMAGE=<required>
