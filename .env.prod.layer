# 生产部署的环境差异值（主机名/端口/URL）。compose 的 env_file 把 .env.prod 注入容器，
# 不进镜像；改值后重建容器生效，无需重建镜像。
# 与 .env.shared.layer 合并生成生产环境的 .env.prod。

# ── 应用 ──────────────────────────────────────────────
# docker-compose.yml 的端口映射与 healthcheck 使用此端口
APP_PORT=3042

# ESA 生产函数的独立鉴权密钥（32～128 位可见 ASCII 字符，不含空格），不要复用开发密钥或 OSS AccessKey。
# 与生产函数的加密变量 ALIYUN_ESA_AUTH_KEY 一致；需先发布 config/esa/content-auth.mjs，env:build 提示填写。
ALIYUN_ESA_AUTH_KEY=<required>

# ESA 管理 API（附件退役后的缓存刷新，仅服务端），独立于上面的链接鉴权密钥。
# RAM 用户：stupig-esa-purge-prod；策略：stupig-esa-purge-prod-access。
# 最小权限：指定站点的 esa:PurgeCaches、esa:DescribePurgeTasks。
# 实际凭证通过 pnpm env:build:prod 填入本地 .env.prod，使用生产环境的独立凭证。
ALIYUN_ESA_ACCESS_KEY_ID=<required>
ALIYUN_ESA_ACCESS_KEY_SECRET=<required>
# 填写生产附件域名所属 ESA 站点的 SiteId；与开发共用站点时，RAM 权限同样覆盖该站点。
ALIYUN_ESA_SITE_ID=<required>

# 官方 ESA CLI 的独立发布凭据；生产使用独立 RAM 用户，不复用开发或缓存刷新凭据。
# 通过 pnpm env:build:prod 填入本地 .env.prod，不将真实凭据写入模板。
# 发布权限与流程见 docs/deployment/esa-functions.md；目标统一在 config/prod.yaml 的 esaFunction 栏目。
# pnpm esa:deploy:prod 同时选择生产 YAML 和凭据；Deploy 工作流在应用健康后自动调用。
ALIYUN_ESA_PUBLISH_ACCESS_KEY_ID=<required>
ALIYUN_ESA_PUBLISH_ACCESS_KEY_SECRET=<required>

# OSS 通用默认值在 config/shared.yaml，生产地址、地域和桶名在 config/prod.yaml。
# 静态资源和 Content 均使用 ALIYUN_OSS_*，不再需要旧 S3 凭据。

# 生产必须为 false，服务端启动会校验
NUXT_OTP_DEBUG=false
NUXT_CAPTCHA_DEBUG=false

# ── MySQL ─────────────────────────────────────────────
# 容器网络内的主机名
MYSQL_HOST=<required>
MYSQL_PORT=3306
MYSQL_USER=<required>
MYSQL_DATABASE=<required>

# ── Redis ─────────────────────────────────────────────
REDIS_HOST=<required>
REDIS_PORT=6379
REDIS_PASSWORD=<required>

# ── MQTT / EMQX ───────────────────────────────────────
# 服务端连接 EMQX 的凭据，必须是强密码；浏览器端不需要这两个变量，
# 浏览器在匿名 WS/WSS listener 上仅由 ACL 允许订阅；clientId 前缀不授予权限
MQTT_USERNAME=<required>
MQTT_PASSWORD=<required>
MQTT_HOST=<required>
MQTT_TCP_PORT=1883
# 浏览器 WebSocket 连接（YAML 显式引用后下发到客户端）：
# 填反代+SSL 后的完整地址（如 wss://mqtt.example.com/mqtt，无需端口）
MQTT_WEB_URL=<required>

# ── 部署（docker-compose.yml 使用）─────────────────────
# 应用容器接入的外部 Docker 网络名（由 1panel 等外部创建）
EXTERNAL_DOCKER_NETWORK=<required>
ACR_IMAGE=<required>
# 阿里云 DYPNS 与目标 OSS 的独立凭证占位见 .env.shared.layer。
# 发布前同步新变量名并重新加密生产环境文件；旧源凭证保留到回滚窗口结束。
